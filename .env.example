# Скопировать в .env и править при необходимости

# БД (psycopg — миграции и воркер, asyncpg подставляется автоматически для api)
DATABASE_URL=postgresql+psycopg://app:app@db:5432/ktru
REDIS_URL=redis://redis:6379/0

# Куда сохраняются загруженные файлы спецификаций
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10
MAX_ITEMS=1000

# LLM-провайдер: none | ollama | gigachat | yandex | openai-compat
LLM_PROVIDER=none
LLM_MODEL=
